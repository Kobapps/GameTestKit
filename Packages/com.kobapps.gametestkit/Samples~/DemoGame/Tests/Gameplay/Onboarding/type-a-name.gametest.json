{
  "name": "Engraving a name",
  "description": "Typing into the shop's input field delivers real text events, character by character.",
  "tags": ["shop", "demo"],
  "category": "Gameplay/Onboarding",

  "setup": [
    { "call": "demo.reset" },
    { "call": "demo.start" },
    { "click": "id:shop_button" },
    { "waitForVisible": "id:name_field" }
  ],

  "steps": [
    { "type": "Ada Lovelace", "into": "id:name_field", "clear": true },
    { "press": "enter" },

    { "waitFor": "demo.playerName == 'Ada Lovelace'", "timeout": 5 },
    { "assertText": "id:status_label", "contains": "Engraved for Ada" }
  ],

  "teardown": [
    { "call": "demo.reset" }
  ]
}
