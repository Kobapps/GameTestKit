{
  "name": "Demo gameplay",
  "description": "The four gameplay cases — shop, cards, onboarding — with one retry and screenshots on failure.",

  // One category covers all three folders beneath it: Gameplay/Shop, Gameplay/Cards and
  // Gameplay/Onboarding. That is the difference between a category and a tag — categories nest, so
  // this line keeps working when somebody adds Gameplay/Settings tomorrow.
  "categories": ["Gameplay"],

  "options": {
    "retries": 1,
    "stopOnFirstFailure": false,
    "pointer": "mouse",
    "inputSpeed": 1,
    "screenshotOnFailure": true,
    "failOnLogError": true,
    "reportFormats": ["junit", "json", "html"]
  }
}
